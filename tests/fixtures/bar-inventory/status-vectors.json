{
  "$comment": "Bar Inventory V1 golden vectors (BI-0). Consumed by the TypeScript domain mirror (BI-2) and the pgTAP generator for inventory_stock_status (BI-2). total = round(on_hand + backup, 2). effective_warning = warning ?? (cutoff == null ? null : cutoff + max(1, ceil(cutoff * 0.25))). status: archived > no_cutoff (cutoff null) > critical (total <= cutoff) > low (total <= effective_warning) > healthy. suggested_order applies to critical and low only: max(0, par - total); par null => suggested_order null and order_needed true.",
  "rules": {
    "decimals": 2,
    "warningFallbackRatio": 0.25,
    "warningFallbackMinStep": 1
  },
  "vectors": [
