        "backup": 1,
        "cutoff": 4,
        "warning": 6,
        "par": 12,
        "archived": false
      },
      "expected": {
        "total": 3,
        "effective_warning": 6,
        "status": "critical",
        "suggested_order": 9,
        "order_needed": false
      }
    },
