    },
    {
      "id": "thirty-plus",
      "total": 100,
      "cutoff": 8,
      "rate_7d": 1,
      "rate_30d": 0.5,
      "enoughHistory": true,
      "expected": "30+ days"
    },
    {
      "id": "low-end-known-high-end-open",
      "total": 20,
      "cutoff": 8,
      "rate_7d": 1,
      "rate_30d": 0.2,
      "enoughHistory": true,
      "expected": "12–30+ days"
    },
    {
      "id": "no-cutoff",
      "total": 20,
      "cutoff": null,
      "rate_7d": 1,
      "rate_30d": 0.5,
      "enoughHistory": true,
      "expected": "No cutoff set"
    }
  ],
  "cutoffCrossings": [
    {
      "id": "chronic-two-crossings",
      "$comment": "A crossing is a ledger row whose status_after is critical while the previous row's status_after was not critical. cutoff_at_time is stored per row, so later cutoff edits never rewrite history.",
      "rows": [
        {
          "date": "2026-10-01",
          "status_after": "healthy",
          "cutoff_at_time": 10
        },
        {
          "date": "2026-10-05",
          "status_after": "critical",
          "cutoff_at_time": 10
        },
        {
          "date": "2026-10-06",
          "status_after": "critical",
          "cutoff_at_time": 10
        },
        {
          "date": "2026-10-10",
          "status_after": "healthy",
          "cutoff_at_time": 10
        },
        {
          "date": "2026-10-20",
          "status_after": "critical",
          "cutoff_at_time": 6
        }
      ],
      "window_days": 30,
      "expected": { "crossings": 2, "chronic": true }
    },
    {
      "id": "stays-critical-is-one-crossing",
      "rows": [
        {
          "date": "2026-10-05",
          "status_after": "critical",
          "cutoff_at_time": 10,
          "previous_status": "low"
        },
        {
          "date": "2026-10-06",
          "status_after": "critical",
          "cutoff_at_time": 10
        },
        {
          "date": "2026-10-07",
          "status_after": "critical",
          "cutoff_at_time": 10
        }
      ],
      "window_days": 30,
      "expected": { "crossings": 1, "chronic": false }
    }
  ],
  "localDay": [
    {
      "id": "late-evening-belongs-to-local-service-date",
      "timezone": "America/New_York",
      "event_at_utc": "2026-10-27T03:30:00Z",
      "expected_local_date": "2026-10-26"
    },
    {
      "id": "dst-fall-back-day",
      "timezone": "America/New_York",
      "event_at_utc": "2026-11-01T05:30:00Z",
      "expected_local_date": "2026-11-01"
    },
    {
      "id": "dst-fall-back-late",
      "timezone": "America/New_York",
      "event_at_utc": "2026-11-02T04:30:00Z",
