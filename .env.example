# Browser-safe Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only maintenance tasks. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APP_PIN_PEPPER=

# Used by local CLI and CI. Do not commit real values.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESTAURANT_SLUG=the-monks
# Set true only for the local/reference demo. Never enable demo credentials for a real restaurant.
NEXT_PUBLIC_DEMO_MODE=true
